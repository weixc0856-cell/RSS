# 生产环境配置文件
# 复制此文件为 .env.production 并填入实际的生产环境 ID
# This file is NOT tracked by Git (.gitignore)

# Cloudflare KV Namespace - Production
PROD_KV_NAMESPACE_ID=your-prod-kv-namespace-id

# Cloudflare D1 Database - Production
PROD_D1_DATABASE_ID=6d199e6f-87a7-4177-b7bb-862d72f61797
PROD_D1_DATABASE_NAME=rss-db

# Cloudflare R2 Bucket - Production
PROD_R2_BUCKET_NAME=rss-bucket
PROD_R2_ACCOUNT_ID=your-prod-account-id

# Cloudflare Queues
RSS_FETCH_QUEUE=rss-fetch-queue
RSS_FETCH_QUEUE_PROD=rss-fetch-queue-prod
RSS_FETCH_DLQ=rss-fetch-dlq

# API Configuration - Production
API_RATE_LIMIT=1000
CACHE_TTL_SECONDS=7200

# Feed Configuration - Production
MAX_FEED_ITEMS=100
FEED_FETCH_INTERVAL_MINUTES=15

# Environment
ENVIRONMENT=production
LOG_LEVEL=warn
