<header class="topbar">
  <div>
    <h1>Signals</h1>
    <div class="sub" id="subtitle">Loading feeds…</div>
  </div>

  <input id="search" class="search" type="search" placeholder="Search signals…" />

  <select id="sort" class="sort" aria-label="Sort">
