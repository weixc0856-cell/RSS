<aside class="sidebar">
  <div class="brand">
    <div class="brand-mark">R</div>
    <div>
      <div class="brand-name">RSS Intelligence</div>
      <div class="brand-sub">Cloudflare Worker feeds</div>
    </div>
  </div>

  <div class="nav-label">Feeds</div>
  <nav class="nav" id="feedNav" aria-label="Feeds"></nav>

  <!-- One-click subscribe suggestions, two independent segments rendered by
       app.ts (renderDiscover): the static Recommended catalog (from
       recommended-feeds.ts — "Recommended") followed by the shared-pool tail
       (pool feeds outside that catalog — "Shared pool"). Suggestions are only
       ever added here on click — nothing auto-subscribes. -->
  <div id="discover" class="discover" aria-label="Discover recommended feeds and shared pool"></div>

  <div class="sidebar-bottom">
    <form class="feed-form" id="feedForm">
      <input
        id="feedUrl"
        type="url"
        placeholder="https://example.com/feed.xml"
        required
      />
      <input id="feedTitle" type="text" placeholder="Title (optional)" />
      <button class="action-btn primary" type="submit">Add feed</button>
    </form>

    <div class="sync">
      <span class="dot" id="healthDot"></span>
      <span id="healthText">Loading…</span>
    </div>
  </div>
</aside>
