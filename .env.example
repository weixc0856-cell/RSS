# Cloudflare KV Namespace
KV_NAMESPACE_ID=your-kv-namespace-id
PROD_KV_NAMESPACE_ID=your-prod-kv-namespace-id

# Cloudflare D1 Database
D1_DATABASE_ID=your-dev-database-id
D1_DATABASE_NAME=rss-db-dev
PROD_D1_DATABASE_ID=your-prod-database-id
PROD_D1_DATABASE_NAME=rss-db

# Cloudflare R2 Bucket
R2_BUCKET_NAME=rss-bucket-dev
PROD_R2_BUCKET_NAME=rss-bucket
R2_ACCOUNT_ID=your-account-id
PROD_R2_ACCOUNT_ID=your-account-id

# Cloudflare Queues
RSS_FETCH_QUEUE=rss-fetch-queue
RSS_FETCH_DLQ=rss-fetch-dlq

# API Configuration
API_RATE_LIMIT=100
CACHE_TTL_SECONDS=3600

# Feed Configuration
MAX_FEED_ITEMS=50
FEED_FETCH_INTERVAL_MINUTES=30

# Environment
ENVIRONMENT=development
LOG_LEVEL=debug
